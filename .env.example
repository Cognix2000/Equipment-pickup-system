# Copie para .env e troque cada "troque-…" por um valor seu. O .env nunca vai para o Git.
# Para gerar um valor forte: openssl rand -hex 24
BANCO_SENHA_DONO=troque-esta-senha
BANCO_SENHA_API=troque-esta-senha

# ADR-008: deixe vazio para não exportar telemetria. Com o perfil "observabilidade":
# OTEL_ENDPOINT=http://observabilidade:4317
OTEL_ENDPOINT=
# RN05: aceita telefones fictícios com DDD 00. Em produção, false.
IMPORTACAO_MODO_SIMULACAO=true
# RN14: chave e segredo do armazenamento das fotos (SeaweedFS).
FOTOS_CHAVE=troque-esta-chave
FOTOS_SEGREDO=troque-este-segredo
# Porta do app na sua máquina. Mude se a 8080 já estiver em uso (ex.: 8081).
WEB_PORTA=8080
