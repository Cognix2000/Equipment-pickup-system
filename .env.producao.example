# Produção. Copie para .env no servidor e troque cada "troque-…" por um valor forte:
#   openssl rand -hex 24
# O .env nunca vai para o Git. Guarde uma cópia num cofre de senhas: sem ela, o backup do banco não abre.

# Versão em produção: sempre uma tag lançada (ADR-006), como v0.1.0. O deploy recusa "main".
# Para lançar uma versão: docs/implantacao.md, "Lançar uma versão".
VERSAO=v0.1.0

# Domínio que aponta para este servidor (registro DNS tipo A). O HTTPS sai para ele.
DOMINIO=pedro.devioslab.com.br

BANCO_SENHA_DONO=troque-esta-senha
BANCO_SENHA_API=troque-esta-senha

# RN14: chave e segredo do armazenamento das fotos (SeaweedFS), só dentro do Docker.
FOTOS_CHAVE=troque-esta-chave
FOTOS_SEGREDO=troque-este-segredo

# O app só fica acessível pelo Caddy (HTTPS). A porta 8080 escuta só no próprio servidor, para diagnóstico.
WEB_PORTA=127.0.0.1:8080

# RN05: em produção, só telefone real (o docker-compose.producao.yml já força false).
IMPORTACAO_MODO_SIMULACAO=false

# ADR-008: vazio = não exporta telemetria.
OTEL_ENDPOINT=

# Repasse ao técnico por retirada conferida, em centavos (500 = R$ 5,00). Vale só para as próximas conferências.
VALOR_POR_RETIRADA_CENTAVOS=500

# Modo demonstração: true carrega os usuários de teste e as ordens fictícias (docker-compose.demonstracao.yml).
# Só ANTES de entrar com dados reais. A senha dos usuários de teste é esta (gere com: openssl rand -base64 18).
MODO_DEMONSTRACAO=false
SENHA_DEMONSTRACAO=
