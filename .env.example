# Copie para .env. O .env nunca vai para o Git.
# Estas senhas batem com appsettings.Development.json e servem só na sua máquina.
# Em homologação, troque as duas.
BANCO_SENHA_DONO=retirada_dono_dev
BANCO_SENHA_API=retirada_api_dev

# ADR-008: deixe vazio para não exportar telemetria. Com o perfil "observabilidade":
# OTEL_ENDPOINT=http://observabilidade:4317
OTEL_ENDPOINT=
