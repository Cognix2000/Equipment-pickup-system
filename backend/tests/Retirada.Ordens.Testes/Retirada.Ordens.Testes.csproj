    <None Include="..\..\..\ferramentas\dados-ficticios\*.xlsx" LinkBase="Planilhas" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modulos\Retirada.Ordens\Retirada.Ordens.csproj" />
  </ItemGroup>

