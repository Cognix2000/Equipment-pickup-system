<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\Retirada.Comum\Retirada.Comum.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" Version="4.3.3" />
    <PackageReference Include="WebPush" Version="1.0.11" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <!-- Força a 11.0.0, que corrige GHSA-vmv3-wvjp-wqpj (DoS por recursão em
         CBOR profundo). O Fido2 4.3.2 ainda puxa a 9.0.0 por transitivo, e o
         NuGetAudit do CI trata o advisory como erro. Pode sair quando o Fido2
         subir a dependência. -->
    <PackageReference Include="System.Formats.Cbor" Version="11.0.0" />
    <!-- Força a 13.0.3: o WebPush 1.0.11 puxa a 10.0.3 por transitivo, que tem
         GHSA-5crp-9r3c-p9vr (vulnerabilidade alta), e o NuGetAudit do CI trata
         o advisory como erro. Pode sair quando o WebPush subir a dependência. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retirada.Acesso.Testes" />
    <InternalsVisibleTo Include="Retirada.Api.Testes" />
  </ItemGroup>

</Project>
